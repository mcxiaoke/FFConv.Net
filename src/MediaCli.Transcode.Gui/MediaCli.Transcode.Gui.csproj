<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MediaCli.Transcode.Gui</RootNamespace>
    <AssemblyName>FFConv</AssemblyName>
    <Product>FFConv</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试项目需要驱动 TranscodeSession.ForwardCoreLogForTest 等内部接缝，
         以便在不启动真实 ffmpeg 的前提下断言日志转发行为。 -->
    <InternalsVisibleTo Include="MediaCli.Transcode.Gui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaCli.Transcode\MediaCli.Transcode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
